{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "../Logs/Serilog.log",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} <s:{SourceContext}>{NewLine}{Exception}"
        }
      }
    ]
  },
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=random_task_track;Username=rtt;Password=rtt;SSL Mode=Disable;Enlist=false;Pooling=true;Minimum Pool Size=1;Maximum Pool Size=20;Connection Lifetime=300;Include Error Detail=true;"
  },
  "Jwt": {
    "SecretKey": "ReplaceWithASecureSecretKeyOfAtLeast_32_Chars!",
    "Issuer": "RandomTaskTrack",
    "Audience": "RandomTaskTrackClients",
    "ExpiryInMinutes": 43200
  },
  "Ai": {
    "Provider": "anthropic",
    "Model": "claude-opus-5",
    "ApiKey": "",
    "MaxTokens": 16000,
    "MaxToolIterations": 8,
    "ProviderOptions": {
      "effort": "high"
    }
  },
  "Recipes": {
    "Provider": "spoonacular",
    "ApiKey": "",
    "BaseUrl": "https://api.spoonacular.com",
    "CandidatesPerPull": 10
  },
  "Finance": {
    "BaseCurrency": "EUR",
    "Provider": "yahoo",
    "BaseUrl": "https://query1.finance.yahoo.com"
  },
  "Scheduler": {
    "MaterializeHorizonDays": 21,
    "MaterializeIntervalMinutes": 60,
    "TimeZone": "Europe/Vilnius"
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
