# Copy to .env and fill in. Never commit .env.

# ── Database ─────────────────────────────────────────────────────────────────
DB_NAME=random_task_track
DB_USER=rtt
DB_PASSWORD=change-me

# ── Auth ─────────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET_KEY=change-me-to-at-least-32-characters-long
JWT_ISSUER=RandomTaskTrack
JWT_AUDIENCE=RandomTaskTrackClients
# 43200 minutes = 30 days
JWT_EXPIRY_MINUTES=43200

# ── AI ───────────────────────────────────────────────────────────────────────
# Leave AI_API_KEY empty to run without chat — everything else still works.
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5
AI_API_KEY=
AI_MAX_TOKENS=16000
AI_EFFORT=high
# Lets the plant lookup search the web. Billed per search on top of tokens;
# set false if the key's organisation does not have the tool enabled.
AI_WEB_SEARCH=true

# ── Recipes ──────────────────────────────────────────────────────────────────
# Free key from spoonacular.com/food-api (150 calls/day). Leave empty to run
# without the recipes tab — the rest of the app is unaffected.
RECIPE_PROVIDER=spoonacular
RECIPE_API_KEY=

# ── Finance ──────────────────────────────────────────────────────────────────
# No key: prices come from Yahoo's public chart endpoint, so the tab works as
# soon as it is deployed. Set FINANCE_PROVIDER=null to turn the refresh button
# off — everything else is hand-entered and keeps working either way.
#
# FINANCE_BASE_CURRENCY must match a row in tracker.fin_currencies, and that row
# must have rate_to_base = 1.
FINANCE_BASE_CURRENCY=EUR
FINANCE_PROVIDER=yahoo

# ── App ──────────────────────────────────────────────────────────────────────
API_PORT=5080
TIME_ZONE=Europe/Vilnius
# The origin the tablet UI is served from. This API is internet-facing, so
# leave it set rather than allowing any origin.
CORS_ORIGIN=http://localhost:3000
